+  ciclo,
+  sedeAsignadaId: null,
+  estado: 'activo',
+});
+
+export const estudiantesOperacion = [
+  estudiante('usr_102', '20221534', 'Camila', 'Rojas Quispe', 'camila.rojas@ulima.edu.pe', 'Ingeniería de Sistemas', 7),
