+/* src/components/features/operation/tray/SpaceGroup.module.css */
+/* Estilos del grupo por espacio y de sus filas (ReservationRow los comparte). */
+
+.root {
+  overflow: hidden;
+  background-color: var(--color-surface);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-md);
+}
+
+.header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--space-2) var(--space-4);
+  padding: var(--space-3) var(--space-5);
+  background-color: var(--color-primary-soft);
+  border-bottom: 1px solid var(--color-border);
+}
+
+.title {
+  font-size: var(--text-base);
+  font-weight: var(--weight-bold);
+  color: var(--color-ink);
+}
+
+.meta {
+  margin: 0;
+  font-size: var(--text-sm);
+  color: var(--color-muted);
+}
+
+/* En pantallas angostas la tabla se desplaza dentro de su caja, no la página. */
+.scroll {
+  position: relative; /* contiene al texto oculto (.srOnly) dentro del scroll */
+  overflow-x: auto;
+}
+
+.table {
+  width: 100%;
+  min-width: 960px;
+  table-layout: fixed;
+  border-collapse: collapse;
+  font-size: var(--text-md);
+}
+
+.colBlock {
+  width: 130px;
+}
+
+.colStudent {
+  width: 22%;
+}
+
+.colAttendees {
+  width: 72px;
+}
+
+.colStatus {
+  width: 124px;
+}
+
+.colActions {
+  width: 280px;
+}
+
+.colToggle {
+  width: 56px;
+}
+
+.table th {
+  padding: var(--space-3) var(--space-5);
+  background-color: var(--color-bg);
+  border-bottom: 1px solid var(--color-border);
+  font-size: var(--text-xs);
+  font-weight: var(--weight-semibold);
+  letter-spacing: var(--tracking-label);
+  text-align: left;
+  text-transform: uppercase;
+  color: var(--color-muted);
+  white-space: nowrap;
+}
+
+.table td {
+  padding: var(--space-3) var(--space-5);
+  vertical-align: middle;
+}
+
+.row + .row td,
+.detailRow + .row td {
+  border-top: 1px solid var(--color-border);
+}
+
+.rowExpanded td {
+  background-color: var(--color-bg);
+}
+
+.block {
+  font-weight: var(--weight-bold);
+  white-space: nowrap;
+}
+
+.student {
+  overflow-wrap: anywhere;
+}
+
+.muted {
+  color: var(--color-muted);
+}
+
+.toggleCell {
+  text-align: right;
+}
+
+.toggle {
+  padding: var(--space-1) var(--space-2);
+  border: 0;
+  border-radius: var(--radius-sm);
+  background: transparent;
+  font-size: var(--text-sm);
+  color: var(--color-primary);
+}
+
+.toggle:hover {
+  background-color: var(--color-primary-soft);
+}
+
+.toggle:focus-visible {
+  outline: 2px solid var(--color-primary);
+  outline-offset: 2px;
+}
+
+/* La fila de detalle ocupa todo el ancho y no lleva padding propio. */
